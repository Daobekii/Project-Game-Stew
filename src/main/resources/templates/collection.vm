<html lang="en">
<head>
    <title>Project: Game Stew — $collection.getName()</title>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="stylesheet" href="/css/main.css">

    <style>
        img {
            max-height: 2.5rem;
        }
        .search-rec {
            cursor: pointer;
            text-decoration: underline;
        }
    </style>
    <script>
        function updateSearchResults(results) {
            let res = document.getElementById("results")
            res.innerHTML = "";
            results.forEach(r => {
                let item = document.createElement("li");
                item.classList.add("search-rec");

                item.innerText = r["name"];
                item.addEventListener("click", e => {
                    fetch(`add_to_collection?coll=$collection.getID()&game=${r["id"]}`).then(() => location.reload());
                })

                res.appendChild(item);
            })
        }
        function search() {
            let q = document.getElementById('search-input').value;
            if (q.length < 3) {
                updateSearchResults([]);
                return;
            }
            fetch(`search?q=${q}`)
                    .then(r => r.json())
                    .then(j => updateSearchResults(j));
        }
    </script>
</head>
<body>
<div class="container">
    <header>
        <h1><img src="$collection.getIcon()" alt="collection icon"> Collection — $collection.getName()</h1>
    </header>

    <section id="add-items">
        <h2>Add Items</h2>
        <p>Search for games to add to your collections.</p>
        <div class="search-input-hero">
            <svg
                    class="search-icon"
                    xmlns="http://www.w3.org/2000/svg"
                    width="16"
                    height="16"
                    viewBox="0 0 16 16"
                    fill="none"
                    role="img"
            >
                <path
                        fill-rule="evenodd"
                        clip-rule="evenodd"
                        d="M10.6002 12.0498C9.49758 12.8568 8.13777 13.3333 6.66667 13.3333C2.98477 13.3333 0 10.3486 0 6.66667C0 2.98477 2.98477 0 6.66667 0C10.3486 0 13.3333 2.98477 13.3333 6.66667C13.3333 8.15637 12.8447 9.53194 12.019 10.6419C12.0265 10.6489 12.0338 10.656 12.0411 10.6633L15.2935 13.9157C15.6841 14.3063 15.6841 14.9394 15.2935 15.33C14.903 15.7205 14.2699 15.7205 13.8793 15.33L10.6269 12.0775C10.6178 12.0684 10.6089 12.0592 10.6002 12.0498ZM11.3333 6.66667C11.3333 9.244 9.244 11.3333 6.66667 11.3333C4.08934 11.3333 2 9.244 2 6.66667C2 4.08934 4.08934 2 6.66667 2C9.244 2 11.3333 4.08934 11.3333 6.66667Z"
                ></path>
            </svg>
            <label for="search-input" class="accessibility-text"
            >Search for Games</label
            >
            <input
                    id="search-input"
                    type="text"
                    placeholder="Search for Games..."
                    oninput="search()"
            />
        </div>

    </section>

    <section id="stew-results">
        <ul id="results"></ul>
    </section>

    <section id="games">
        <h2>Games</h2>
        <ul>
            #foreach($game in $collection.getGames())
                <li>
                    <img src="$game.getImageUrl()" alt="game cover image">
                    <a href="https://boardgamegeek.com/boardgame/$game.getID()">$game.getName()</a>
                    <button class="remove" onclick="fetch('remove_from_collection?coll=$collection.getID()&game=$game.getID()').then(() => location.reload())">➖ Remove</button>
                </li>
            #end
        </ul>
    </section>

    <footer>

        <button onclick="window.location.href='/collections';">🔙 Back to Collections</button>
        <button onclick="window.location.href='/';">🔙 Back to Stew</button>
    </footer>
</div>
</body>
</html>